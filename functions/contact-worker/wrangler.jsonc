{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bekamar-contact-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "vars": {
    "EMAIL_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://bekamar.com,https://www.bekamar.com",
    "TURNSTILE_HOSTNAMES": "bekamar.com,www.bekamar.com"
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      // Replace before deployment with an integer unique in the Bekamar Cloudflare account.
      "namespace_id": "2026110801",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "env": {
    "dev": {
      "name": "bekamar-contact-api-dev",
      "workers_dev": true,
      "vars": {
        "EMAIL_ENABLED": "false",
        "ALLOWED_ORIGINS": "https://bekamar.com,https://www.bekamar.com,http://localhost:5500,http://127.0.0.1:5500",
        "TURNSTILE_HOSTNAMES": "bekamar.com,www.bekamar.com,localhost,127.0.0.1",
        "TURNSTILE_TEST_MODE": "true"
      },
      "ratelimits": [
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "2026110802",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
